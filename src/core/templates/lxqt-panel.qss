/* {{name}} — generated by lxqt-personalizer, regenerate instead of editing. */

LXQtPanel #BackgroundWidget {
    background-color: {{panel}};
    color: {{panel_fg}};
}

QToolTip {
    background-color: {{bg_alt}};
    color: {{fg}};
    border: 1px solid {{border}};
    padding: 3px;
}

LXQtPanelPlugin {
    color: {{panel_fg}};
}

/* Not every icon theme has an icon for the menu button. */
#MainMenu,
#FancyMenu {
    qproperty-icon: url(mainmenu.svg);
}

LXQtPanelPlugin > QToolButton,
#QuickLaunch QToolButton,
#DesktopSwitch QToolButton,
#TaskBar QToolButton {
    color: {{panel_fg}};
    background: transparent;
    border: none;
    border-radius: {{panel_radius}}px;
    padding: 1px 3px;
}

LXQtPanelPlugin > QToolButton:hover,
#QuickLaunch QToolButton:hover,
#DesktopSwitch QToolButton:hover,
#TaskBar QToolButton:hover {
    background-color: {{panel_hover}};
}

LXQtPanelPlugin > QToolButton:pressed,
#QuickLaunch QToolButton:pressed,
#DesktopSwitch QToolButton:pressed,
#TaskBar QToolButton:pressed {
    background-color: rgba({{accent_rgb}}, 0.55);
}

#TaskBar QToolButton {
    margin: {{task_margin}};
    padding: 0 8px;
}

#TaskBar QToolButton:on,
#DesktopSwitch QToolButton:on {
{{task_on_rules}}
}

#TaskBar QToolButton:on:hover,
#DesktopSwitch QToolButton:on:hover {
{{task_on_hover_rules}}
}

#TaskBar QToolButton[urgent="true"],
#DesktopSwitch QToolButton[urgent="true"] {
    background-color: rgba(229, 115, 0, 0.55);
}

#TaskBar LXQtGroupPopup {
    background-color: {{bg}};
    border: 1px solid {{border}};
}

#TaskBar LXQtGroupPopup QToolButton {
    color: {{fg}};
}

#Clock #TimeLabel,
#Clock #DateLabel {
    color: {{panel_fg}};
}

#Clock:hover {
    background-color: {{panel_hover}};
}

QMenu {
    background-color: {{bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    padding: 3px;
}

QMenu::item {
    padding: 4px 22px 4px 8px;
    border-radius: {{menu_item_radius}}px;
}

QMenu::item:selected {
    background-color: {{accent}};
    color: {{accent_fg}};
}

QMenu::item:disabled {
    color: {{fg_dim}};
}

QMenu::separator {
    height: 1px;
    background: {{border}};
    margin: 3px 6px;
}

#MainMenu QLineEdit,
#FancyMenu QLineEdit {
    background-color: {{surface}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 3px;
    padding: 3px;
    selection-background-color: {{accent}};
    selection-color: {{accent_fg}};
}

#MainMenu ActionView,
#FancyMenu #AppView,
#FancyMenu #CategoryView {
    background-color: {{bg}};
    color: {{fg}};
    border: none;
}

#MainMenu ActionView::item:hover,
#FancyMenu QListView::item:hover {
    background-color: rgba({{accent_rgb}}, 0.30);
}

#MainMenu ActionView::item:selected,
#FancyMenu QListView::item:selected {
    background-color: {{accent}};
    color: {{accent_fg}};
}

LXQtFancyMenuWindow,
#FancyMenu {
    background-color: {{bg}};
    color: {{fg}};
}

VolumePopup,
#Backlight > SliderDialog {
    background-color: {{bg}};
    color: {{fg}};
    border: 1px solid {{border}};
}

VolumePopup QSlider::groove:vertical,
#Backlight > SliderDialog > QSlider::groove:vertical {
    background: {{bg_alt}};
    width: 4px;
}

VolumePopup QSlider::handle:vertical,
#Backlight > SliderDialog > QSlider::handle:vertical {
    background: {{accent}};
    height: 12px;
    margin: 0 -5px;
    border-radius: 6px;
}

VolumePopup QSlider::add-page:vertical,
#Backlight > SliderDialog > QSlider::add-page:vertical {
    background: rgba({{accent_rgb}}, 0.6);
}

QCalendarWidget QWidget {
    background-color: {{bg}};
    color: {{fg}};
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: {{surface}};
    color: {{fg}};
    selection-background-color: {{accent}};
    selection-color: {{accent_fg}};
}
