/* {{name}} — generated by lxqt-personalizer, regenerate instead of editing. */

Notification {
    background-color: {{bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
}

Notification:hover {
    border-color: {{accent}};
}

Notification #appLabel,
Notification #summaryLabel {
    color: {{fg}};
    font-weight: bold;
}

Notification #bodyLabel {
    color: {{fg}};
}
