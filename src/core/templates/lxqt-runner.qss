/* {{name}} — generated by lxqt-personalizer, regenerate instead of editing. */

#panel {
    background-color: {{bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
}

#commandEd {
    background-color: {{surface}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 3px;
    padding: 4px;
    selection-background-color: {{accent}};
    selection-color: {{accent_fg}};
}

#commandList {
    background-color: {{bg}};
    color: {{fg}};
    border: none;
    selection-background-color: {{accent}};
    selection-color: {{accent_fg}};
}

#commandList::item:hover {
    background-color: rgba({{accent_rgb}}, 0.30);
}
